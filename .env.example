# Single project-root .env. Copy to .env and fill in.
#
# Loaded by:
#   - gmail-mbox-parser/Makefile and calendar-parser/Makefile (-include ../.env)
#   - fill_db / fill_events Rust binaries (dotenvy::from_path("../.env"))
#   - webapp server (config.ts reads ../.env relative to project root)
#
# Importing from the webapp needs none of this: the import screen asks for the
# email. The file is for the command-line parsers and optional settings.

# Your Gmail address. Required for the command-line parsers (fill-db, and
# event_attendees in the calendar parser); in the webapp it is only the default
# offered on the import screen.
USER_EMAIL=you@gmail.com

# ---- Docker (optional; command-line parse only; see docs/cli.md) ----
# Which mbox in data/Email/ to parse. fill_db takes exactly one file and
# rebuilds the mails table from it, so there is no globbing.
MBOX_FILE=data.mbox

# Linux/macOS only: make container-written files belong to you instead of root.
# These are shell variables, not exported env vars, so Compose only sees them
# from here (or after an explicit `export UID GID`). Ignored on Windows/WSL2.
#UID=1000
#GID=1000
