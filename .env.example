# Single project-root .env. Copy to .env and fill in.
#
# Loaded by:
#   - gmail-mbox-parser/Makefile and calendar-parser/Makefile (-include ../.env)
#   - fill_db / fill_events Rust binaries (dotenvy::from_path("../.env"))
#   - webapp server (config.ts reads ../.env relative to project root)

# Webapp user. Required for fill-db (mbox parser), event_attendees population
# (calendar parser), and the webapp server's "you" node in the graph.
USER_EMAIL=you@gmail.com

# Display name shown for your node in the webapp. Optional; defaults to the
# local-part of USER_EMAIL.
USER_NAME=Your Name

# ---- Hugging Face AI spam filtering (gmail-mbox-parser, optional, BETA) ----
# Leave HF_API_KEY blank to skip AI verification.
#
# Beta: this pass is not deterministic. Which contacts are kept depends on the
# model HF_MODEL names, and the same model can classify differently between
# runs. Everything else in the pipeline is deterministic.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BATCH_SIZE=50
HF_TIMEOUT=120

# ---- Docker (optional; see "Run with Docker" in README.md) ----
# Which mbox in data/Email/ to parse. fill_db takes exactly one file and
# rebuilds the mails table from it, so there is no globbing.
MBOX_FILE=data.mbox

# Linux/macOS only: make container-written files belong to you instead of root.
# These are shell variables, not exported env vars, so Compose only sees them
# from here (or after an explicit `export UID GID`). Ignored on Windows/WSL2.
#UID=1000
#GID=1000
