# Single project-root .env. Copy to .env and fill in.
#
# Loaded by:
#   - gmail-mbox-parser/Makefile and calendar-parser/Makefile (-include ../.env)
#   - fill_db / fill_events Rust binaries (dotenvy::from_path("../.env"))
#   - webapp server (config.ts reads ../.env relative to project root)

# Webapp user. Required for fill-db (mbox parser), event_attendees population
# (calendar parser), and the webapp server's "you" node in the graph.
USER_EMAIL=you@gmail.com

# Display name shown for your node in the webapp. Optional; defaults to the
# local-part of USER_EMAIL.
USER_NAME=Your Name

# ---- Hugging Face AI spam filtering (gmail-mbox-parser, optional) ----
# Leave HF_API_KEY blank to skip AI verification.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BATCH_SIZE=50
HF_TIMEOUT=120
