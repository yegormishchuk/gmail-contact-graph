# Project-root .env. Copy to .env and fill in.
# Picked up by gmail-mbox-parser/Makefile and calendar-parser/Makefile
# (via -include ../.env), and by the fill_events binary via dotenvy.

# Webapp user's primary email. Required for fill-db (mbox parser) and for
# populating the event_attendees table (calendar parser).
USER_EMAIL=you@gmail.com

# Optional: Hugging Face token for AI spam filtering in gmail-mbox-parser.
# HF_API_TOKEN=
